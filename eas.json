{
  "cli": {
    "version": ">=3.0.0"
  },
  "build": {
    "development": {
      "distribution": "internal",
      "developmentClient": false,
      "channel": "development",
      "env": {
        "ENVIRONMENT": "development"
      }
    },
    "staging": {
      "distribution": "internal",
      "channel": "staging",
      "env": {
        "ENVIRONMENT": "staging"
      }
    },
    "production": {
      "channel": "production",
      "env": {
        "ENVIRONMENT": "production"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
